# Arbeitsagentur Jobsuche API (public client ID — no secret required)
JOBSUCHE_API_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service
JOBSUCHE_API_KEY=jobboerse-jobsuche

# Rate limiting (seconds between API requests, shared across workers)
REQUEST_DELAY_SECONDS=0.3

# Parallel detail fetch workers (1 = sequential, safe default)
SCRAPE_WORKERS=1

# Retry on connection reset / 429 / 5xx
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0

# Google Sheets (optional — leave empty to skip Sheets export)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google-service-account.json

# Scraper defaults
DEFAULT_PAGE_SIZE=25
MAX_PAGES_PER_CATEGORY=0
